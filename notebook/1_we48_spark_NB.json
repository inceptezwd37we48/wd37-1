					"## Read Data from ADLS and Write into ADLS - pysprk"
				]
			},
			{
				"cell_type": "code",
				"source": [
					"# abfss://container@SA.dfs.core.net/dir/file\n",
					"sorce_path=\"abfss://wd37we48synapselake@wd37we48sa.dfs.core.windows.net/data/custdata/custs_header\"\n",
					"cust_df=spark.read.csv(sorce_path,header=True,inferSchema=True)\n",
					"\n",
					"cust_df.printSchema()\n",
					"cust_df.show(5)"
				],
				"execution_count": 9
			},
			{
				"cell_type": "code",
				"source": [
					"from pyspark.sql.functions import count\n",
					"\n",
					"agg_df=cust_df.groupBy(\"profession\").agg(count(\"*\").alias(\"totoal_count\"))\n",
					"\n",
					"final_df=agg_df.filter(\"totoal_count>220\")\n",
					"\n",
					"final_df.show()"
				],
				"execution_count": 13
			},
			{
				"cell_type": "code",
				"source": [
					"final_df.write.mode(\"overwrite\").json(\"abfss://wd37we48synapselake@wd37we48sa.dfs.core.windows.net/data/custwe48json\")\n",
					""
