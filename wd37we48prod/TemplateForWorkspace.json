			"type": "Microsoft.Synapse/workspaces/sqlscripts",
			"apiVersion": "2019-06-01-preview",
			"properties": {
				"content": {
					"query": "select 'welcome' as msg;\n\n-- access ADLS -- openrowset\n--  creating External data source / format and creating external table \n\n\nselect top 5 * from \nOPENROWSET\n(\n    BULK 'abfss://wd37we48synapselake@wd37we48sa.dfs.core.windows.net/data/custdata/custs_header' ,\n    FORMAT='CSV',\n    HEADER_ROW=TRUE,\n    PARSER_VERSION='2.0'\n) as cust;",
					"metadata": {
						"language": "sql"
					},
					"currentConnection": {
						"databaseName": "master",
						"poolName": "Built-in"
					},
					"resultLimit": 5000
				},
				"type": "SqlQuery"
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('workspaceName'), '/1_we48_serverless_explorer')]",
			"type": "Microsoft.Synapse/workspaces/sqlscripts",
			"apiVersion": "2019-06-01-preview",
			"properties": {
				"content": {
					"query": "\n\nCREATE DATABASE we48_db;\n\n-- Read Data from ADLS Directly \n\n-- option 1 : using Openrowset \n\n-- option 2 : create a exteral Table on top of ADLS\n--             External Data source \n--             External File Format \n\n\n-- OpenRowset - Serverless only , CSV , parquet , DELTA , JSon (csv tricks)  - adhoc , limited , eDA \n\n-- External Table - avilable in both serverless and dedicated -- resusable , security(table access , view )\n-- Data sit as it is  in ADLS (refering the data )\n-- in case of External Table - metadata managed by synapse , Data managed by external sources and system \n-- External Table , when u drop the table only metdata will be dropped , not data \n\n-- serverless - only support External Table \n-- will not support DML\n\n\n\n\n-- CREATE TABLE emp(eid int , ename VARCHAR(50)); -- supported \n\n\nselect top 5 * from \nOPENROWSET\n(\n    BULK 'abfss://wd37we48synapselake@wd37we48sa.dfs.core.windows.net/data/custdata/custs_header',\n    FORMAT = 'CSV',\n    HEADER_ROW=True,\n    PARSER_VERSION='2.0'\n\n\n) as cust;",
					"metadata": {
						"language": "sql"
					},
					"currentConnection": {
						"databaseName": "master",
						"poolName": "Built-in"
					},
					"resultLimit": 5000
				},
				"type": "SqlQuery"
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('workspaceName'), '/2_Dedicated_explorer')]",
			"type": "Microsoft.Synapse/workspaces/sqlscripts",
			"apiVersion": "2019-06-01-preview",
			"properties": {
				"content": {
					"query": "\n\nCREATE SCHEMA Wd37schema;\n\n\n-- managed / Native Table \n\nCREATE Table Wd37schema.emp\n(\nid int ,\nname VARCHAR(50),\nage int\n)\nWITH\n(\n    DISTRIBUTION=ROUND_ROBIN,-- default \n    CLUSTERED COLUMNSTORE INDEX  -- columnar data format \n)\n;\n\n\nINSERT INTO Wd37schema.emp VALUES (100,'raja',22);\nINSERT INTO Wd37schema.emp VALUES (101,'abc',25);\nINSERT INTO Wd37schema.emp VALUES (103,'synapse',15);\nINSERT INTO Wd37schema.emp VALUES (104,'synapse',15);\n\nINSERT INTO Wd37schema.emp VALUES (105,'sql',15);\n\n\nselect * from Wd37schema.emp;\n\n\n",
					"metadata": {
						"language": "sql"
					},
					"currentConnection": {
						"databaseName": "wd37_sql_pool",
						"poolName": "wd37_sql_pool"
					},
					"resultLimit": 5000
				},
				"type": "SqlQuery"
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('workspaceName'), '/2_we48_Dedicated_sql_explorer')]",
			"type": "Microsoft.Synapse/workspaces/sqlscripts",
			"apiVersion": "2019-06-01-preview",
			"properties": {
				"content": {
					"query": "-- Synapse also following 3 namespace naming standard \n\n\n-- Databse.schema.table\n\n\n-- deafult schema -  dbo\n\n\n-- create Schema \n\nCREATE SCHEMA we48schema;\n\nselect * from sys.schemas;\n\n\nselect * from sys.databases;\n\n\n-- managed Table / Native Table \n\n-- Both data and metedata managed by synapse\n-- data stored by synapse \n-- DML suport (insert , update , delete)\n-- drop the table both data and metadta dropped \n\nCREATE TABLE we48schema.emp(eid int , ename VARCHAR(50));\n\n\nINSERT into we48schema.emp VALUES (100,'raja');\nINSERT into we48schema.emp VALUES (101,'krish');\nINSERT into we48schema.emp VALUES (102,'jaya');\n\n\nselect * from we48schema.emp;\n\n\nCREATE TABLE we48schema.bank_txn_RR\n(\n    txnid int,\n    txndate date,\n    custid VARCHAR(50),\n    amt FLOAT,\n    branch VARCHAR(50),\n    region VARCHAR(50)\n)\nWITH\n(\nDISTRIBUTION=ROUND_ROBIN,  -- distruibuite data eventualy across nodes \nHEAP\n);\n\nINSERT INTO we48schema.bank_txn_RR (txnid, txndate, custid, amt, branch, region)\nVALUES \n(1001, '2026-04-01', 'CUST001', 1500.50, 'T. Nagar', 'Chennai');\nINSERT INTO we48schema.bank_txn_RR (txnid, txndate, custid, amt, branch, region)\nVALUES \n(1002, '2026-04-02', 'CUST002', 2750.00, 'Adyar', 'Chennai');\nINSERT INTO we48schema.bank_txn_RR (txnid, txndate, custid, amt, branch, region)\nVALUES \n(1003, '2026-04-02', 'CUST003', 500.25, 'Jayanagar', 'Bangalore');\nINSERT INTO we48schema.bank_txn_RR (txnid, txndate, custid, amt, branch, region)\nVALUES \n(1004, '2026-04-03', 'CUST001', 3200.00, 'T. Nagar', 'Chennai');\nINSERT INTO we48schema.bank_txn_RR (txnid, txndate, custid, amt, branch, region)\nVALUES \n(1005, '2026-04-05', 'CUST004', 120.00, 'Hitech City', 'Hyderabad');\n\n\nselect * from we48schema.bank_txn_RR;\n\n\n\nCREATE TABLE we48schema.bank_txn_RR\n(\n    txnid int,\n    txndate date,\n    custid VARCHAR(50),\n    amt FLOAT,\n    branch VARCHAR(50),\n    region VARCHAR(50)\n)\nWITH\n(\nDISTRIBUTION=ROUND_ROBIN,  -- distruibuite data eventualy across nodes \nHEAP\n);\n\n\n\n\nCREATE TABLE we48schema.bank_txn_hash\n(\n    txnid int,\n    txndate date,\n    custid VARCHAR(50),\n    amt FLOAT,\n    branch VARCHAR(50),\n    region VARCHAR(50)\n)\nWITH\n(\nDISTRIBUTION=HASH(region),  -- distruibuite data based on region \nCLUSTERED COLUMNSTORE INDEX -- columnar data format - like parquet \n);\n\n\n\n\n\nCREATE TABLE we48schema.bank_txn_rpl\n(\n    txnid int,\n    txndate date,\n    custid VARCHAR(50),\n    amt FLOAT,\n    branch VARCHAR(50),\n    region VARCHAR(50)\n)\nWITH\n(\nDISTRIBUTION=REPLICATE,  -- small table for join and lookup (broadcast spark option)\nCLUSTERED COLUMNSTORE INDEX -- columnar data format - like parquet \n);\n\n\n\n\n\n\n\n",
					"metadata": {
						"language": "sql"
					},
					"currentConnection": {
						"databaseName": "we48_sql_con",
						"poolName": "we48_sql_con"
					},
					"resultLimit": 5000
				},
				"type": "SqlQuery"
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('workspaceName'), '/3_stored_procedure')]",
			"type": "Microsoft.Synapse/workspaces/sqlscripts",
			"apiVersion": "2019-06-01-preview",
			"properties": {
				"content": {
					"query": "ALTER  PROCEDURE Wd37schema.sp_get_emp\nAS\nBEGIN\nDECLARE @r_cnt int=0;\n\nPRINT 'Process started...'\n\nPRINT 'step 1 : getting the count'\nselect @r_cnt=count(1) from  Wd37schema.emp;\n\nPRINT 'step 2 : Total Employess :'+ CAST(@r_cnt as VARCHAR(10));\n\nPRINT ' Step 3 : printing all employee ...';\n\nselect * from Wd37schema.emp;\n\nPRINT 'Process completed...'\n\nEND",
					"metadata": {
						"language": "sql"
					},
					"currentConnection": {
						"databaseName": "wd37_sql_pool",
						"poolName": "wd37_sql_pool"
					},
					"resultLimit": 5000
				},
				"type": "SqlQuery"
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('workspaceName'), '/3_we48_copy_sql')]",
			"type": "Microsoft.Synapse/workspaces/sqlscripts",
			"apiVersion": "2019-06-01-preview",
			"properties": {
				"content": {
					"query": "\n\nCREATE TABLE we48schema.cust\n(\n    custid int,\n    fname VARCHAR(50),\n    lname VARCHAR(50),\n    age int,\n    prof VARCHAR(50)\n)\nWITH\n(\n    CLUSTERED COLUMNSTORE INDEX,\n    DISTRIBUTION=ROUND_ROBIN\n);\n\n\n\nCOPY INTO we48schema.cust FROM\n'https://wd37we48sa.blob.core.windows.net/wd37we48synapselake/data/custdata/custs'\nWITH\n(\nFILE_TYPE='CSV',\nFIRSTROW=1\n\n);\n\n\n\nselect top 5 * from we48schema.cust;\n\n\n\n-- view ( contains query )\n-- virtual table \n-- only query no data \n\n-- security / limit / restrict \n-- always latest \n\nCREATE view we48schema.vw_test\nas \nselect * from we48schema.cust;\n\n-- access \n\n\nselect top 5 * from  we48schema.vw_test;\n\n\n-- Materilized View \n\n-- like a view , but it will contain data as well \n\n-- incremental / auto refresh data when the underlying table got changed\n-- performance \n\nCREATE MATERIALIZED view we48schema.mv_prof_agg\nWITH (DISTRIBUTION =HASH(prof))\nas\nselect prof ,count(1) as total from we48schema.cust GROUP BY prof;\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n",
					"metadata": {
						"language": "sql"
					},
					"currentConnection": {
						"databaseName": "we48_sql_con",
						"poolName": "we48_sql_con"
					},
					"resultLimit": 5000
				},
				"type": "SqlQuery"
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('workspaceName'), '/4_we48_stored_procdure')]",
			"type": "Microsoft.Synapse/workspaces/sqlscripts",
			"apiVersion": "2019-06-01-preview",
			"properties": {
				"content": {
					"query": "-- Stored procedure \n-- database object \n-- precompiled block of sql statements\n-- resuability\n-- business logic with looping and conditional construct \n-- paaremeters\n-- Error handling\n-- block of statements - begin/end , indentation , {}\n\nAlter PROCEDURE we48schema.sp_cust\nAS\nBEGIN\n\nPRINT 'Showing top 10 customer data '\nselect top 10 * from we48schema.cust \nPRINT 'completd.....................!' \nEnd\n\n-- run the procedure\nEXEC we48schema.sp_cust\n\n\n",
					"metadata": {
						"language": "sql"
					},
					"currentConnection": {
						"databaseName": "we48_sql_con",
						"poolName": "we48_sql_con"
