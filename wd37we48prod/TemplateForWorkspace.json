							"\n",
							"cust_df.printSchema()\n",
							"cust_df.show(5)"
						],
						"outputs": [],
						"execution_count": 9
					},
					{
						"cell_type": "code",
						"source": [
							"from pyspark.sql.functions import count\n",
							"\n",
							"agg_df=cust_df.groupBy(\"profession\").agg(count(\"*\").alias(\"totoal_count\"))\n",
							"\n",
							"final_df=agg_df.filter(\"totoal_count>220\")\n",
							"\n",
							"final_df.show()"
						],
